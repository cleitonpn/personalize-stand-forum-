rules_version = '2';

// ============================================================================
//  Quem manda aqui é o servidor, não o app.
//  O papel do usuário vive em /usuarios/{uid}.papel e NUNCA pode ser escrito
//  pelo cliente — só pelo Console do Firebase ou por um backend com service
//  account. Assim ninguém vira admin editando o próprio documento.
// ============================================================================
service cloud.firestore {
  match /databases/{database}/documents {

    function autenticado() {
      return request.auth != null;
    }

    function perfil() {
      return get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data;
    }

    function temPerfil() {
      return autenticado()
        && exists(/databases/$(database)/documents/usuarios/$(request.auth.uid));
    }

    function ehAdmin() {
      return ativo() && perfil().papel == 'admin';
    }

    // Desativar precisa valer no SERVIDOR, não só na tela: sem isto, um
    // expositor desativado continuaria gravando propostas direto pela API,
    // e o bloqueio seria só cosmético.
    function ativo() {
      return temPerfil() && perfil().get('ativo', true) == true;
    }

    function organizadoraDo(dados) {
      return ativo() && perfil().papel == 'organizadora'
        && dados.get('organizadoraId', '') == perfil().organizadoraId;
    }
    function contatoValido(d) {
      return d.contatoNome is string && d.contatoNome.size() > 0 && d.contatoNome.size() <= 180
        && d.telefone is string && d.telefone.size() >= 10 && d.telefone.size() <= 30
        && d.cargo is string && d.cargo.size() <= 180
        && localizacaoValida(d) && d.cadastroCompleto == true;
    }
    function localizacaoValida(d) {
      return d.localizacao is string && d.localizacao.size() <= 180
        && d.localizacaoPendente == (d.localizacao.size() == 0);
    }

    // Perfis. O admin cadastra expositores pelo painel; cada um lê o seu.
    //
    // O expositor NUNCA pode mexer no próprio papel — se pudesse, viraria admin
    // editando o próprio documento. A única escrita que ele faz é desligar o
    // aviso de senha provisória depois de trocá-la.
    match /usuarios/{uid} {
      allow read: if autenticado() && request.auth.uid == uid || ehAdmin() || organizadoraDo(resource.data);
      allow create: if false; // Cadastro de contas somente nas Functions.
      allow delete: if ehAdmin();
      allow update: if ehAdmin()
        || (ativo() && request.auth.uid == uid
            && request.resource.data.diff(resource.data).affectedKeys()
                 .hasOnly(['precisaTrocarSenha'])
            && request.resource.data.precisaTrocarSenha == false)
        || (ativo() && request.auth.uid == uid && perfil().papel == 'expositor'
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['contatoNome','telefone','cargo','localizacao','localizacaoPendente','cadastroCompleto'])
            && contatoValido(request.resource.data))
        || (organizadoraDo(resource.data) && resource.data.papel == 'expositor'
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['localizacao','localizacaoPendente'])
            && localizacaoValida(request.resource.data));
    }

    // Envios criados no servidor após validar vínculo e proteger o GLB.
    match /propostas/{propostaId} {
      allow read:   if ativo() && (resource.data.cliente == request.auth.uid || ehAdmin() || organizadoraDo(resource.data));
      allow create: if false;
      allow update, delete: if ehAdmin();
    }

    // Modelos de estande: qualquer autenticado consulta (o expositor precisa
    // abrir o modelo dele); só o time da montadora cria, edita e apaga.
    match /modelos/{modeloId} {
      allow read: if ehAdmin() || (ativo() && perfil().papel == 'expositor' && perfil().modeloId == modeloId)
        || (ativo() && perfil().papel == 'organizadora' && perfil().organizadoraId in resource.data.get('organizadoraIds', []));
      allow write: if false; // Functions validam admin, versão e acessos aos GLBs.
    }

    // Biblioteca comercial compartilhada. Só a montadora altera o catálogo.
    match /acabamentos/{acabamentoId} {
      allow read: if ativo();
      allow write: if ehAdmin();
    }

    match /mobiliario/{movelId} {
      allow read, write: if ehAdmin();
    }

    match /organizadoras/{id} {
      allow read: if ehAdmin() || (ativo() && perfil().get('organizadoraId','') == id);
      allow write: if false;
    }
    match /feiras/{id} {
      allow read: if ehAdmin() || organizadoraDo(resource.data)
        || (ativo() && perfil().papel == 'expositor' && perfil().get('feiraId','') == id);
      allow write: if false;
    }
    match /pagamentos/{id} {
      allow read: if ehAdmin() || (ativo() && exists(/databases/$(database)/documents/propostas/$(id))
        && (get(/databases/$(database)/documents/propostas/$(id)).data.cliente == request.auth.uid
          || organizadoraDo(get(/databases/$(database)/documents/propostas/$(id)).data)));
      allow write: if false;
    }
    match /emailsSaida/{id} {
      allow read: if ehAdmin();
      allow write: if false;
    }

    function contador(n) { return n is number && n >= 0 && n <= 10000; }
    function etapaValida(e) {
      return e is map && e.keys().hasOnly(['visitas','segundos','erros','concluiu'])
        && contador(e.visitas) && contador(e.erros) && e.concluiu is bool
        && e.segundos is number && e.segundos >= 0 && e.segundos <= 86400;
    }
    function metricaValida(d) {
      let a = d.acoes;
      let e = d.etapas;
      return d.keys().hasOnly(['uid','modeloId','dispositivo','segundos','enviou','ultimaEtapa','acoes','etapas','atualizadoEm'])
        && d.uid == request.auth.uid && d.modeloId == perfil().modeloId
        && d.dispositivo in ['celular','desktop'] && d.enviou is bool
        && d.segundos is number && d.segundos >= 0 && d.segundos <= 86400
        && d.atualizadoEm == request.time
        && d.ultimaEtapa in ['','ambientes','marca','piso','mobiliario','complementos','eletrica','revisao']
        && a is map && a.keys().hasOnly(['reinicio','alteracao','desfazer','refazer','ajuda','upload_erro','envio_erro','glb_erro','cliques_repetidos','envio','carregamento'])
        && contador(a.get('reinicio',0)) && contador(a.get('alteracao',0))
        && contador(a.get('desfazer',0)) && contador(a.get('refazer',0))
        && contador(a.get('ajuda',0)) && contador(a.get('upload_erro',0))
        && contador(a.get('envio_erro',0)) && contador(a.get('glb_erro',0))
        && contador(a.get('cliques_repetidos',0)) && contador(a.get('envio',0)) && contador(a.get('carregamento',0))
        && e is map && e.keys().hasOnly(['ambientes','marca','piso','mobiliario','complementos','eletrica','revisao'])
        && etapaValida(e.ambientes) && etapaValida(e.marca) && etapaValida(e.piso)
        && etapaValida(e.mobiliario) && etapaValida(e.complementos) && etapaValida(e.eletrica) && etapaValida(e.revisao);
    }
    match /sessoesUso/{sessaoId} {
      allow read, delete: if ehAdmin();
      allow create: if ativo() && perfil().papel == 'expositor' && metricaValida(request.resource.data);
      allow update: if ativo() && perfil().papel == 'expositor' && resource.data.uid == request.auth.uid
        && request.resource.data.uid == resource.data.uid && request.resource.data.modeloId == resource.data.modeloId
        && metricaValida(request.resource.data);
    }

    // Projetos do expositor: dono e admin.
    match /projetos/{projetoId} {
      allow read, update, delete: if ativo()
        && (resource.data.dono == request.auth.uid || ehAdmin());
      allow create: if ativo() && request.resource.data.dono == request.auth.uid;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
