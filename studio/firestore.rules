rules_version = '2';

// ============================================================================
//  Quem manda aqui é o servidor, não o app.
//  O papel do usuário vive em /usuarios/{uid}.papel e NUNCA pode ser escrito
//  pelo cliente — só pelo Console do Firebase ou por um backend com service
//  account. Assim ninguém vira admin editando o próprio documento.
// ============================================================================
service cloud.firestore {
  match /databases/{database}/documents {

    function autenticado() {
      return request.auth != null;
    }

    function ehAdmin() {
      return autenticado()
        && exists(/databases/$(database)/documents/usuarios/$(request.auth.uid))
        && get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data.papel == 'admin';
    }

    // Perfis. O admin cadastra expositores pelo painel; cada um lê o seu.
    //
    // O expositor NUNCA pode mexer no próprio papel — se pudesse, viraria admin
    // editando o próprio documento. A única escrita que ele faz é desligar o
    // aviso de senha provisória depois de trocá-la.
    match /usuarios/{uid} {
      allow read:   if autenticado() && (request.auth.uid == uid || ehAdmin());
      allow create: if ehAdmin() && request.resource.data.papel == 'expositor';
      allow delete: if ehAdmin();
      allow update: if ehAdmin()
        || (request.auth.uid == uid
            && request.resource.data.diff(resource.data).affectedKeys()
                 .hasOnly(['precisaTrocarSenha'])
            && request.resource.data.precisaTrocarSenha == false);
    }

    // Propostas do expositor: ele cria e edita a sua; o admin lê todas.
    match /propostas/{propostaId} {
      allow read:   if autenticado() && (resource.data.cliente == request.auth.uid || ehAdmin());
      allow create: if autenticado() && request.resource.data.cliente == request.auth.uid;
      allow update, delete: if autenticado()
        && (resource.data.cliente == request.auth.uid || ehAdmin());
    }

    // Modelos de estande: qualquer autenticado consulta (o expositor precisa
    // abrir o modelo dele); só o time da montadora cria, edita e apaga.
    match /modelos/{modeloId} {
      allow read:  if autenticado();
      allow write: if ehAdmin();
    }

    // Projetos do expositor: dono e admin.
    match /projetos/{projetoId} {
      allow read, update, delete: if autenticado()
        && (resource.data.dono == request.auth.uid || ehAdmin());
      allow create: if autenticado() && request.resource.data.dono == request.auth.uid;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
