rules_version = '2';

// ============================================================================
//  Arquivos .glb dos modelos e artes enviadas pelos expositores.
//  Mesma regra do Firestore: o papel vem de /usuarios/{uid}, nunca do cliente.
// ============================================================================
service firebase.storage {
  match /b/{bucket}/o {

    function autenticado() {
      return request.auth != null;
    }

    function temPerfil() {
      return autenticado()
        && firestore.exists(/databases/(default)/documents/usuarios/$(request.auth.uid));
    }

    function perfil() {
      return firestore.get(/databases/(default)/documents/usuarios/$(request.auth.uid)).data;
    }

    function ehAdmin() {
      return ativo() && perfil().papel == 'admin';
    }
    function acessoOperacional(d) {
      return ativo() && d.get('estado','') == 'liberada' && (ehAdmin()
        || (perfil().papel in ['gerente_operacional','analista_operacional','analista_cv','equipe_producao','produtor','atendimento_comercial','mobiliario','analista_projeto']
          && d.get('feiraId','') in perfil().get('feiraIds',[])
          && (perfil().papel != 'produtor' || request.auth.uid in d.get('produtorIds',[]))
          && (perfil().papel != 'atendimento_comercial' || request.auth.uid in d.get('atendimentoIds',[]))
          && (perfil().papel != 'equipe_producao' || perfil().get('equipeIds',[]).hasAny(d.get('equipeIds',[])))));
    }
    function operacaoProposta(id) {
      return acessoOperacional(firestore.get(/databases/(default)/documents/acessosProducao/$(id)).data);
    }

    // Mesmo motivo do Firestore: desativado não lê o projeto nem sobe arte.
    function ativo() {
      return temPerfil() && perfil().get('ativo', true) == true;
    }

    // Projetos .glb: todo autenticado lê (para abrir o configurador);
    // só admin envia. Limite de 200 MB e apenas glTF binário.
    match /modelos/{arquivo} {
      allow read: if ehAdmin() || (ativo() && firestore.exists(/databases/(default)/documents/arquivosModelo/$(arquivo))
        && ((perfil().papel == 'expositor' && perfil().modeloId in firestore.get(/databases/(default)/documents/arquivosModelo/$(arquivo)).data.modeloIds)
          || (perfil().papel == 'organizadora' && perfil().organizadoraId in firestore.get(/databases/(default)/documents/arquivosModelo/$(arquivo)).data.organizadoraIds)));
      allow delete: if ehAdmin();
      allow create, update: if ehAdmin()
        && request.resource.size < 200 * 1024 * 1024
        && (request.resource.contentType == 'model/gltf-binary'
            || request.resource.contentType == 'application/octet-stream');
    }

    // Artes que o expositor sobe para aplicar nas lonas.
    match /artes/{uid}/{arquivo} {
      allow read: if ehAdmin() || (ativo() && (request.auth.uid == uid
        || (perfil().papel == 'organizadora' && firestore.get(/databases/(default)/documents/usuarios/$(uid)).data.get('organizadoraId','') == perfil().organizadoraId)));
      allow write: if ativo()
        && request.auth.uid == uid
        && request.resource.size < 25 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
    }

    // Cada envio recebe um arquivo próprio. Propostas enviadas não são sobrescritas.
    match /propostas/{uid}/{propostaId}/estande.glb {
      allow read: if ativo() && (perfil().papel in ['gerente_operacional','analista_operacional','analista_cv','equipe_producao','produtor','atendimento_comercial','mobiliario','analista_projeto'] ? operacaoProposta(propostaId) : (ehAdmin() || acessoProposta(propostaId)));
      allow create: if resource == null && ativo() && request.auth.uid == uid
        && !firestore.exists(/databases/(default)/documents/propostas/$(propostaId))
        && request.resource.size < 200 * 1024 * 1024
        && request.resource.contentType == 'model/gltf-binary';
      allow delete: if false; // Preserva GLB de propostas na lixeira.
    }

    function acessoProposta(id) {
      let p = firestore.get(/databases/(default)/documents/propostas/$(id)).data;
      return ativo() && (ehAdmin() || p.cliente == request.auth.uid
        || (perfil().papel == 'organizadora' && perfil().organizadoraId == p.organizadoraId));
    }
    match /producao/{propostaId}/{uploadId}/arquivo {
      function reserva() { return firestore.get(/databases/(default)/documents/artesPropostas/$(propostaId)/uploads/$(uploadId)).data; }
      allow read: if ativo() && (perfil().papel in ['gerente_operacional','analista_operacional','analista_cv','equipe_producao','produtor','atendimento_comercial','mobiliario','analista_projeto'] ? operacaoProposta(propostaId) : acessoProposta(propostaId));
      // A reserva já foi autorizada pela Function. Aqui consultamos somente
      // o perfil e a reserva: Storage permite no máximo dois documentos Firestore.
      allow create: if resource == null && ativo() && reserva().uid == request.auth.uid
        && reserva().usado == false && reserva().expiraEm > request.time
        && request.resource.size == reserva().bytes && request.resource.contentType == reserva().mime
        && ((reserva().tipo == 'arte' && perfil().papel == 'expositor' && request.resource.size <= 300 * 1024 * 1024)
          || (reserva().tipo == 'apoio' && perfil().papel == 'expositor' && request.resource.size <= 30 * 1024 * 1024)
          || (reserva().tipo == 'prova' && perfil().papel in ['admin','analista_cv'] && request.resource.size <= 30 * 1024 * 1024))
        && request.resource.contentType in ['application/pdf','image/png','image/jpeg','image/svg+xml','application/postscript'];
      // Versões e provas são imutáveis: nem uma aprovação antiga permite
      // substituir silenciosamente o arquivo já aprovado.
      allow update, delete: if false;
    }
    match /operacao/{tipo}/{parentId}/{uploadId} {
      function destino() { return firestore.get(/databases/(default)/documents/$(tipo)/$(parentId)).data; }
      function reserva() { return firestore.get(/databases/(default)/documents/uploadsOperacionais/$(uploadId)).data; }
      allow read: if (tipo == 'ordensProducao' && acessoOperacional(destino()))
        || (tipo == 'equipesOperacionais' && (ehAdmin() || (ativo() && perfil().papel in ['gerente_operacional','analista_operacional','analista_cv','equipe_producao','produtor','atendimento_comercial','mobiliario','analista_projeto'] && perfil().get('feiraIds',[]).hasAny(destino().get('feiraIds',[])))));
      allow create: if ativo() && reserva().uid == request.auth.uid && reserva().tipo == tipo && reserva().parentId == parentId
        && reserva().usado == false && reserva().expiraEm > request.time
        && request.resource.size == reserva().bytes && request.resource.size <= 30 * 1024 * 1024 && request.resource.contentType == reserva().mime;
      allow update, delete: if false;
    }

    match /fotosPendencias/{ordemId}/{revisao}/{pendenciaId}/{uploadId} {
      function reserva() { return firestore.get(/databases/(default)/documents/uploadsFotosPendencias/$(uploadId)).data; }
      allow read: if acessoOperacional(firestore.get(/databases/(default)/documents/ordensProducao/$(ordemId)).data);
      // Perfil + reserva: respeita o limite de dois documentos do Storage.
      allow create: if resource == null && ativo() && reserva().uid == request.auth.uid
        && reserva().ordemId == ordemId && reserva().pendenciaId == pendenciaId
        && reserva().caminho == 'fotosPendencias/' + ordemId + '/' + revisao + '/' + pendenciaId + '/' + uploadId
        && reserva().usado == false && reserva().expiraEm > request.time
        && request.resource.size == reserva().bytes && request.resource.size <= 15 * 1024 * 1024
        && request.resource.contentType == reserva().mime
        && request.resource.contentType in ['image/jpeg','image/png','image/webp'];
      allow update, delete: if false;
    }
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
